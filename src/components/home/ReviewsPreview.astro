---
import ReviewCard from "../reviews/ReviewCard.astro";
import { getAvaliacoesAprovadas } from "@/lib/reviews";

const avaliacoes = await getAvaliacoesAprovadas(3);
const temAvaliacoes = avaliacoes.length > 0;
---

<section class="reviews-preview">
  <div class="container">
    <div class="reviews-preview__header">
      <div class="section-title">
        <span class="section-title__eyebrow">
          Experiências especiais
        </span>

        <h2>
          O carinho de quem{" "}
          <span> já celebrou connosco</span>
        </h2>
      </div>

      <div class="reviews-preview__intro">
      </div>
    </div>

    {
      temAvaliacoes && (
        <div class="reviews-preview__grid">
          {
            avaliacoes.map((review) => (
              <ReviewCard
                name={review.nome}
                rating={review.classificacao}
                comment={review.comentario}
                orderType={review.ocasiao ?? "Encomenda"}
              />
            ))
          }
        </div>
      )
    }

    <div class="reviews-preview__footer">
      <div>
        <strong>Já fez uma encomenda?</strong>

        <p>
          Partilhe a sua experiência e ajude outras pessoas a
          escolher a criação perfeita para a sua celebração.
        </p>
      </div>

      <a href="/avaliacoes" class="button button--secondary">
        Deixar avaliação
      </a>
    </div>
  </div>
</section>