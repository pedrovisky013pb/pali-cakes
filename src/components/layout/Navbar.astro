---
import MobileMenu from "./MobileMenu.astro";
import { getCategories, categoriasVisiveisNaNavegacao } from "@/lib/categories";

const categories = await getCategories();

const catalogCategories = categoriasVisiveisNaNavegacao(categories);

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
const isCatalogActive = pathname.startsWith("/catalogo");
---

<header class="navbar">
  <div class="container navbar__container">

    <nav
      class="navbar__menu navbar__menu--left"
      aria-label="Navegação principal esquerda"
    >
      <a
        href="/sobre"
        class:list={{ "is-active": isActive("/sobre") }}
        aria-current={isActive("/sobre") ? "page" : undefined}
      >
        Sobre
      </a>

      <div class="navbar__dropdown">
        <button
          type="button"
          aria-haspopup="true"
          class:list={{ "is-active": isCatalogActive }}
          aria-current={isCatalogActive ? "page" : undefined}
        >
          Catálogo
          <span aria-hidden="true">⌄</span>
        </button>

        <div class="navbar__dropdown-menu">
          {
            catalogCategories.map((category) => (
              <a href={category.href}>
                {category.name}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href="/packs-festa"
        class:list={{ "is-active": isActive("/packs-festa") }}
        aria-current={isActive("/packs-festa") ? "page" : undefined}
      >
        Packs Festa
      </a>
    </nav>

    <a
      href="/carrinho"
      class="navbar__cart navbar__cart--mobile"
      aria-label="Abrir carrinho de encomenda, 0 artigos"
    >
      <span aria-hidden="true">🛒</span>
      <span data-cart-count>0</span>
    </a>

    <a
      href="/"
      class="navbar__logo"
      aria-label="Ir para a página inicial"
    >
      <img
        src="/images/logos/logo-nav-trimmed.png"
        alt="Pali Cakes"
      />
    </a>

    <nav
      class="navbar__menu navbar__menu--right"
      aria-label="Navegação principal direita"
    >
      <a
        href="/portfolio"
        class:list={{ "is-active": isActive("/portfolio") }}
        aria-current={isActive("/portfolio") ? "page" : undefined}
      >
        Portfólio
      </a>

      <a
        href="/contactos"
        class:list={{ "is-active": isActive("/contactos") }}
        aria-current={isActive("/contactos") ? "page" : undefined}
      >
        Contactos
      </a>

      <a
        href="/faq"
        class:list={{ "is-active": isActive("/faq") }}
        aria-current={isActive("/faq") ? "page" : undefined}
      >
        FAQ
      </a>
      <a
      
        href="/carrinho"
        class="navbar__cart"
        aria-label="Abrir carrinho de encomenda, 0 artigos"
      >
        <span aria-hidden="true">🛒</span>

        <span data-cart-count>
          0
        </span>
      </a>
    </nav>

    <button
      class="navbar__toggle"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>
</header>

<MobileMenu />

<script>
  import "../../scripts/menu.ts";
</script>
