---
import { getCategories, categoriasVisiveisNaNavegacao } from "@/lib/categories";

const categories = await getCategories();

const catalogCategories = categoriasVisiveisNaNavegacao(categories);

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(href);
const isCatalogActive = pathname.startsWith("/catalogo");
---

<nav
  class="mobile-menu"
  id="mobile-menu"
  aria-label="Navegação mobile"
  aria-hidden="true"
  inert
>
  <div class="mobile-menu__content">
    <a href="/sobre" class:list={{ "is-active": isActive("/sobre") }}>Sobre</a>

    <details class="mobile-menu__catalog">
      <summary class:list={{ "is-active": isCatalogActive }}>
        Catálogo{" "}
        <span aria-hidden="true">+</span>
      </summary>

      <div class="mobile-menu__submenu">
        {
          catalogCategories.map((category) => (
            <a href={category.href}>
              {category.name}
            </a>
          ))
        }
      </div>
    </details>

    <a href="/packs-festa" class:list={{ "is-active": isActive("/packs-festa") }}>Packs Festa</a>
    <a href="/portfolio" class:list={{ "is-active": isActive("/portfolio") }}>Portfólio</a>
    <a href="/contactos" class:list={{ "is-active": isActive("/contactos") }}>Contactos</a>
    <a href="/faq" class:list={{ "is-active": isActive("/faq") }}>FAQ</a>

    <a href="/carrinho" class="mobile-menu__cart">
      Minha encomenda{" "}

      <span
        class="mobile-menu__cart-count"
        data-cart-count
      >
        0
      </span>
    </a>
  </div>
</nav>
