---
import MainLayout from "@/layouts/MainLayout.astro";
import { getProductsByCategory } from "@/lib/products";

// Conteúdo de cada pack vem do admin (campo "O que inclui o pack").
const packs = (await getProductsByCategory("packs-festa")).filter(
  (pack) => pack.packContents.length > 0
);

const escaparHtml = (texto: string): string =>
  texto.replace(/[&<>"']/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c
  );

const respostaConteudoPacks = packs
  .map(
    (pack) =>
      `<p><strong><a href="/packs-festa/${pack.slug}">${escaparHtml(pack.name)}</a></strong></p>
       <ul>${pack.packContents.map((linha) => `<li>${escaparHtml(linha)}</li>`).join("")}</ul>`
  )
  .join("");

const faqs = [
  {
    grupo: "Encomendas",
    perguntas: [
      {
        p: "Como faço uma encomenda?",
        r: `<ol>
          <li><strong>Escolha os produtos</strong> no menu Catálogo. Em alguns produtos escolhe também o sabor ou opções como massa, cobertura e recheio — nesse caso, é preciso escolher uma opção em cada grupo antes de continuar.</li>
          <li><strong>Clique em "Adicionar à encomenda".</strong> Pode juntar vários produtos no mesmo pedido e revê-los no <a href="/carrinho">carrinho</a>, onde também pode ajustar as quantidades.</li>
          <li><strong>Clique em "Finalizar encomenda"</strong> e preencha os seus dados de contacto, a data da celebração (com pelo menos 30 dias de antecedência) e o tipo de celebração.</li>
          <li><strong>Conte-nos os detalhes</strong> em "Observações e personalização": tema, cores, número de pessoas, etc. Em bolos personalizados, bento cakes, miniaturas (incluindo cupcakes) e packs pode também enviar até 4 fotos de inspiração (nos packs, pelo menos uma foto para o bolo é obrigatória).</li>
          <li><strong>Escolha levantamento ou entrega</strong> e indique o horário que prefere. Na entrega, a taxa é calculada automaticamente a partir do código postal.</li>
          <li><strong>Envie o pedido.</strong> Recebe logo uma referência da encomenda.</li>
          <li><strong>Entramos em contacto</strong> para confirmar os detalhes e enviar o orçamento final. Só depois da sua aprovação a data fica reservada.</li>
        </ol>`
      },
      {
        p: "Com quanta antecedência devo encomendar?",
        r: "Recomendamos pelo menos 30 dias de antecedência. Para encomendas maiores, packs de festa ou datas muito procuradas (fins de semana, épocas festivas), quanto mais cedo melhor. Pedidos de última hora dependem sempre da disponibilidade."
      },
      {
        p: "O site cobra pagamento online?",
        r: "Não. O site serve para nos enviar o seu pedido. O valor é definido no orçamento, depois de conhecermos os detalhes da sua encomenda, e o pagamento é combinado diretamente consigo."
      },
      {
        p: "Posso alterar ou cancelar a minha encomenda?",
        r: "Alterações são possíveis desde que comunicadas com antecedência e antes do início da produção. Como cada criação é feita de raiz e por medida, alterações tardias podem não ser possíveis. Cancelamentos devem ser comunicados com pelo menos 7 dias úteis antes da data do evento: dentro deste prazo, o sinal de 50% pago é devolvido; após este prazo, o valor do sinal não é reembolsado."
      }
    ]
  },
  {
    grupo: "Packs de festa",
    perguntas: [
      {
        p: "O que são os packs de festa?",
        r: "São conjuntos de doces pensados para festas de 10, 20, 30, 40 ou 50 pessoas. Reúnem tudo numa só encomenda, para tornar a sua festa mais simples — e o valor final mais vantajoso."
      },
      ...(respostaConteudoPacks
        ? [
            {
              p: "O que inclui cada pack?",
              r: respostaConteudoPacks
            }
          ]
        : []),
      {
        p: "Como encomendo um pack?",
        r: `<ol>
          <li>Abra a página <a href="/packs-festa">Packs Festa</a> e escolha o pack de acordo com o número de convidados.</li>
          <li>Clique em "Adicionar à encomenda". Pode juntar o pack a outros produtos.</li>
          <li>Ao finalizar a encomenda, indique nas "Observações e personalização" a <strong>massa e o recheio do bolo</strong> e os <strong>sabores dos doces</strong> — no pack não há opções para escolher, por isso estas informações são obrigatórias.</li>
          <li>Envie <strong>pelo menos uma foto de referência</strong> para o bolo.</li>
        </ol>
        <p>A encomenda fica sujeita a avaliação e ao orçamento final, com base nas informações enviadas.</p>`
      },
      {
        p: "Posso escolher os sabores do pack?",
        r: "Sim. As quantidades de cada pack são fixas, mas a massa e o recheio do bolo e os sabores dos doces são escolhidos por si: basta indicá-los nas observações ao finalizar a encomenda. Confirmamos tudo consigo antes do orçamento final."
      },
      {
        p: "E se nenhum pack for o ideal para a minha festa?",
        r: "Pode pedir um <strong>pack personalizado</strong>, montado à medida com as quantidades de cada doce para o seu número de convidados. O pack personalizado tem quantidades mínimas por tipo de doce. Use o botão \"Pedir pack personalizado\" na página <a href=\"/packs-festa\">Packs Festa</a>."
      }
    ]
  },
  {
    grupo: "Alergénios e ingredientes",
    perguntas: [
      {
        p: "Que alergénios estão presentes nas criações da Pali Cakes?",
        r: "As nossas criações contêm habitualmente <strong>cereais com glúten (trigo), ovos, leite e derivados</strong>. Consoante o produto, podem também conter <strong>frutos de casca rija, soja, amendoim e sementes de sésamo</strong>. Indicamos sempre a composição do produto que encomendar — basta perguntar."
      },
      {
        p: "Existe risco de contaminação cruzada?",
        r: "Sim. A produção é artesanal e decorre numa cozinha onde se manipulam glúten, ovos, leite, frutos de casca rija e outros alergénios, com utensílios e superfícies partilhados. <strong>Por esse motivo, não podemos garantir a ausência total de qualquer alergénio em nenhum produto</strong>, mesmo nas versões preparadas sem determinado ingrediente."
      },
      {
        p: "Tenho uma alergia grave. Posso encomendar?",
        r: "Se tem alergia grave, intolerância severa ou doença celíaca diagnosticada, <strong>fale connosco antes de encomendar</strong> para avaliarmos em conjunto. Havendo risco para a sua saúde, preferimos ser honestos e recusar a encomenda a assumir um risco que não conseguimos controlar."
      },
      {
        p: "Fazem opções sem glúten, sem lactose ou vegan?",
        r: "Sim, mediante encomenda especial e sujeitas a disponibilidade. Estas versões são preparadas sem o ingrediente em causa, mas — pelas razões acima — <strong>não são adequadas a alergias graves nem a doença celíaca</strong>. Consulte-nos com antecedência para verificarmos a viabilidade."
      },
      {
        p: "Os ingredientes são frescos?",
        r: "Sim. Trabalhamos com ingredientes frescos e cada encomenda é preparada especificamente para a sua data, nunca antecipadamente em stock."
      }
    ]
  },
  {
    grupo: "Levantamento e entrega",
    perguntas: [
      {
        p: "Como recebo a minha encomenda?",
        r: "Pode optar por levantamento no local combinado ou por entrega local. A entrega tem um custo que depende da zona e é indicado no orçamento. Ambas as opções são escolhidas no momento do pedido."
      },
      {
        p: "Qual o horário de levantamento e de entrega?",
        r: "Levantamentos: segunda a sexta das 10h às 16h; aos sábados, domingos e feriados das 10h às 12h. Já as entregas não têm horário fixo — o horário é sempre combinado diretamente consigo, consoante a zona e a disponibilidade. Ao finalizar a encomenda, pode indicar o horário que prefere e entraremos em contacto para confirmar."
      },
      {
        p: "Como devo transportar o bolo?",
        r: "Se optar por levantamento, transporte a caixa numa superfície plana e nivelada — o chão do carro, atrás do banco, é o mais seguro. Evite o porta-bagagens, bancos inclinados e travagens bruscas. No verão, use ar condicionado e evite deixar o bolo ao sol."
      }
    ]
  },
  {
    grupo: "Conservação",
    perguntas: [
      {
        p: "Como devo conservar a minha encomenda?",
        r: "Guarde no frigorífico, dentro da caixa e afastada de alimentos com cheiro intenso. Retire cerca de 30 a 60 minutos antes de servir, para que os sabores e a textura recuperem à temperatura ambiente."
      },
      {
        p: "Quanto tempo dura?",
        r: "Recomendamos consumir no próprio dia ou, no máximo, até 48 horas após a entrega, conservando sempre refrigerado. Por serem produtos artesanais e sem conservantes, a qualidade é sempre melhor nas primeiras horas."
      }
    ]
  },
  {
    grupo: "Personalização",
    perguntas: [
      {
        p: "Posso escolher o tema, as cores e os sabores?",
        r: "Sim — é precisamente isso que fazemos. Conte-nos a ocasião, as cores, o tema e as suas preferências de sabor, e desenvolvemos uma proposta à medida. Fotografias de inspiração ajudam muito."
      },
      {
        p: "E se eu quiser um bolo muito personalizado, diferente do que está no site?",
        r: "Sem problema — criações muito elaboradas, esculpidas ou fora do que está no catálogo também são possíveis, mas exigem mais tempo de planeamento e produção. Nestes casos, pedimos aviso prévio com uma antecedência maior do que a habitual, para garantirmos disponibilidade e o resultado que imagina. Fale connosco o quanto antes com a sua ideia."
      },
      {
        p: "Fazem réplicas de bolos que eu vi noutro sítio?",
        r: "Usamos imagens como inspiração, mas cada criação é interpretada ao nosso estilo. Não reproduzimos trabalhos de outros profissionais nem personagens ou marcas protegidas por direitos de autor."
      },
      {
        p: "Porque é que os preços são sob consulta?",
        r: "Porque cada encomenda é única. O valor depende do tamanho, do número de camadas, do recheio, do nível de detalhe da decoração e da quantidade. Envie-nos a sua ideia e receberá um orçamento personalizado, sem compromisso."
      }
    ]
  }
];
---

<MainLayout
  title="Perguntas frequentes | Pali Cakes"
  description="Como encomendar, packs de festa, alergénios, conservação, entregas e personalização. Tudo o que precisa de saber antes de encomendar na Pali Cakes."
>
  <section class="faq-hero">
    <div class="container">

      <span class="section-title__eyebrow">Perguntas frequentes</span>

      <h1>Tudo o que precisa de saber</h1>

      <p>
        Reunimos aqui as dúvidas mais comuns sobre encomendas, ingredientes,
        conservação e entregas. Se não encontrar a sua resposta, fale connosco.
      </p>
    </div>
  </section>

  <section class="faq-page">
    <div class="container">
      {
        faqs.map((seccao) => (
          <div class="faq-group">
            <h2>{seccao.grupo}</h2>

            <div class="faq-list">
              {
                seccao.perguntas.map((item) => (
                  <details class="faq-item">
                    <summary>
                      <span>{item.p}</span>
                      <span class="faq-item__icon" aria-hidden="true">+</span>
                    </summary>
                    <div class="faq-item__answer" set:html={item.r} />
                  </details>
                ))
              }
            </div>
          </div>
        ))
      }

      <aside class="faq-notice">
        <h2>Informação sobre alergénios</h2>
        <p>
          A Pali Cakes é uma produção artesanal. Todos os produtos são preparados
          numa cozinha onde se manipulam cereais com glúten, ovos, leite, frutos
          de casca rija e outros alergénios, pelo que <strong>não é possível
          garantir a ausência de vestígios em nenhuma criação</strong>.
        </p>
        <p>
          Se tem alergia, intolerância ou doença celíaca, contacte-nos antes de
          encomendar. A informação detalhada sobre a composição de cada produto
          está disponível a pedido.
        </p>
      </aside>

      <div class="faq-cta">
        <span class="section-title__eyebrow">Não encontrou a resposta?</span>
        <h2>Fale connosco</h2>
        <p>Teremos todo o gosto em esclarecer qualquer dúvida sobre a sua encomenda.</p>
        <a href="/contactos" class="button button--primary">Contactar a Pali Cakes</a>
      </div>
    </div>
  </section>
</MainLayout>