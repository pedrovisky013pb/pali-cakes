---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout
  title="Avaliações | Pali Cakes"
  description="Moderação de avaliações."
  noindex
>
  <section class="admin-page">
    <div class="container">

      <header class="admin-page__header">
        <div>
          <span class="section-title__eyebrow">Área reservada</span>
          <h1>Avaliações</h1>
        </div>

        <div class="admin-nav">
          <a href="/admin/encomendas">Encomendas</a>
          <a href="/admin/produtos">Produtos</a>
          <a href="/admin/avaliacoes" class="is-active">Avaliações</a>
          <a href="/admin/fotos">Fotos do site</a>
          <a href="/admin/conta">Conta</a>
          <button type="button" class="button button--secondary" data-logout>
            Sair
          </button>
        </div>
      </header>
      <div class="admin-publish">
        <div>
          <strong>Publicar alterações</strong>
          <p>
            As alterações que faz aqui só aparecem no site depois de publicar.
            Demora cerca de 2 minutos.
          </p>
        </div>

        <button type="button" class="button button--primary" data-publicar>
          Publicar alterações
        </button>
      </div>

      <p class="admin-publish__status" data-publicar-estado hidden></p>

      <div class="admin-filters" data-filters>
        <button type="button" class="is-active" data-filter="todos">Todas</button>
        <button type="button" data-filter="pendente">Pendentes</button>
        <button type="button" data-filter="aprovada">Aprovadas</button>
        <button type="button" data-filter="rejeitada">Rejeitadas</button>
      </div>

      <div data-reviews-list>
        <p class="admin-loading">A carregar avaliações…</p>
      </div>

    </div>
  </section>

  <script>
    import "@/scripts/admin-avaliacoes.ts";
    import "@/scripts/admin-produtos.ts";
    import "@/scripts/admin-publicar.ts";
  </script>
</MainLayout>