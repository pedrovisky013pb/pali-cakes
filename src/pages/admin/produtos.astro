---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout
  title="Produtos | Pali Cakes"
  description="Gestão de produtos."
  noindex
>
  <section class="admin-page">
    <div class="container">

      <header class="admin-page__header">
        <div>
          <span class="section-title__eyebrow">Área reservada</span>
          <h1>Produtos</h1>
        </div>

        <div class="admin-nav">
          <a href="/admin/encomendas">Encomendas</a>
          <a href="/admin/produtos" class="is-active">Produtos</a>
          <a href="/admin/avaliacoes">Avaliações</a>
          <a href="/admin/fotos">Fotos do site</a>
          <a href="/admin/conta">Conta</a>
          <button type="button" class="button button--secondary" data-logout>
            Sair
          </button>
        </div>
      </header>
      <div class="admin-publish">
        <div>
          <strong>Publicar alterações</strong>
          <p>
            As alterações que faz aqui só aparecem no site depois de publicar.
            Demora cerca de 2 minutos.
          </p>
        </div>

        <button type="button" class="button button--primary" data-publicar>
          Publicar alterações
        </button>
      </div>

      <p class="admin-publish__status" data-publicar-estado hidden></p>

      <p class="admin-hint">
        As alterações ficam guardadas de imediato, mas o site público
        só as mostra após a próxima publicação (cerca de 2 minutos).
      </p>

      <div class="admin-list-actions">
        <input
          type="search"
          class="admin-search"
          data-produto-pesquisa
          placeholder="Pesquisar por nome ou categoria…"
          aria-label="Pesquisar produtos"
        />

        <button type="button" class="button button--primary" data-novo-produto>
          + Novo produto
        </button>
      </div>

      <div data-products-list>
        <p class="admin-loading">A carregar produtos…</p>
      </div>

    </div>
  </section>

  <script>
    import "@/scripts/admin-produtos.ts";
    import "@/scripts/admin-encomendas.ts";
    import "@/scripts/admin-publicar.ts";
  </script>
</MainLayout>