---
import type { GetStaticPaths } from "astro";

import MainLayout from "@/layouts/MainLayout.astro";

import { getCategories, type CatalogCategory } from "@/lib/categories";
import { getProducts, type Product } from "@/lib/products";
import { QUANTIDADE_MAXIMA, priceTierRows } from "@/lib/pricing";


export const getStaticPaths = (async () => {
  const [products, categories] = await Promise.all([
    getProducts(),
    getCategories()
  ]);

  return products
    .filter((product) => product.categorySlug !== "packs-festa")
    .map((product) => ({
      params: {
        slug: product.categorySlug,
        productSlug: product.slug
      },
      props: {
        product,
        category:
          categories.find(
            (c) => c.categorySlug === product.categorySlug
          ) ?? null
      }
    }));
}) satisfies GetStaticPaths;


interface Props {
  product: Product;
  category: CatalogCategory | null;
}

const { product, category } = Astro.props;

const hasFlavors = product.flavors.length > 0;
const canBrowseFlavors = product.flavors.length > 1;
const defaultFlavor = hasFlavors ? product.flavors[0] : null;

// Tamanhos com preço próprio: o primeiro vem escolhido e define o preço, o
// mínimo e (se tiver) a foto iniciais; ao trocar de tamanho, tudo muda no navegador.
const hasSizes = product.sizes.length > 0;
const defaultSize = hasSizes ? product.sizes[0] : null;

const displayImage = defaultFlavor?.imagem || defaultSize?.imagem || product.image;
const hasVariantGroups = product.variantGroups.length > 0;

// Galeria: só quando as setas não estão a ser usadas para trocar de sabor.
const galleryImages = Array.from(
  new Set([displayImage, ...product.gallery].filter(Boolean))
);
const showGallery = !canBrowseFlavors && galleryImages.length > 1;

// Preço inicial: tamanho escolhido > sabor escolhido (se tiver preço) > produto.
const initialPrice = defaultSize
  ? defaultSize.preco
  : defaultFlavor?.preco ?? product.price;
const initialMinQuantity = defaultSize ? defaultSize.quantidade_minima : product.minQuantity;

const euro = new Intl.NumberFormat("pt-PT", {
  style: "currency",
  currency: "EUR"
});

const formattedPrice =
  initialPrice !== null ? euro.format(initialPrice) : product.priceLabel;

// Preço por quantidade (ex.: brigadeiros mais baratos a partir de 30 un.).
const tierRows = priceTierRows(initialPrice, product.quantityTiers, initialMinQuantity);
const hasTiers = tierRows.length > 0;
const tiersJson = hasTiers ? JSON.stringify(product.quantityTiers) : "";

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description || `Criação artesanal ${product.name} da Pali Cakes.`,
  image: new URL(product.image || "/images/og-pali-cakes.jpg", Astro.site).href,
  sku: product.id,
  category: category?.name ?? product.categorySlug,
  brand: {
    "@type": "Brand",
    name: "Pali Cakes"
  }
};
---


<MainLayout
  title={`${product.name} | Pali Cakes`}
  description={product.description || `Conheça ${product.name}, uma criação artesanal da Pali Cakes.`}
  image={product.image || "/images/og-pali-cakes.jpg"}
  schema={productSchema}
>

  <section class="product-detail">

    <div class="container product-detail__container">


      <div class="product-detail__visual" data-gallery>

        <div class="product-detail__image">

          <img
            src={displayImage}
            alt={product.name}
            data-product-image-display
            data-gallery-image
          />

          {showGallery && (
            <>
              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--prev"
                data-gallery-prev
                aria-label="Foto anterior"
              >
                ‹
              </button>

              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--next"
                data-gallery-next
                aria-label="Foto seguinte"
              >
                ›
              </button>
            </>
          )}

          {canBrowseFlavors && (
            <>
              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--prev"
                data-flavor-prev
                aria-label="Sabor anterior"
              >
                ‹
              </button>

              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--next"
                data-flavor-next
                aria-label="Sabor seguinte"
              >
                ›
              </button>
            </>
          )}

        </div>

        {showGallery && (
          <div class="product-detail__thumbs">
            {galleryImages.map((src, index) => (
              <button
                type="button"
                class:list={[
                  "product-detail__thumb",
                  { "is-active": index === 0 }
                ]}
                data-gallery-thumb={src}
                aria-label={`Ver foto ${index + 1}`}
                aria-current={index === 0 ? "true" : "false"}
              >
                <img src={src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}

      </div>



      <div class="product-detail__content">

        <span class="section-title__eyebrow">
          {category?.name ?? "Pali Cakes"}
        </span>



        <h1>
          {product.name}
        </h1>



        {product.description && (
          <p class="product-detail__description">
            {product.description}
          </p>
        )}



        <div class="product-detail__price">

          <span>
            Valor
          </span>

          <strong
            data-price-display
            data-price-label={product.priceLabel}
            data-base-price={product.price ?? ""}
          >
            {formattedPrice}
          </strong>

        </div>



        {hasSizes && (
          <div class="product-detail__flavors">

            <span class="product-detail__flavors-label">
              Escolha o tamanho
            </span>

            <div
              class="product-detail__flavor-options"
              role="radiogroup"
              aria-label="Tamanho"
              data-size-group
            >
              {product.sizes.map((size, index) => (
                <button
                  type="button"
                  class:list={[
                    "product-detail__flavor-option",
                    { "is-selected": index === 0 }
                  ]}
                  data-size-option
                  data-size-name={size.nome}
                  data-size-price={size.preco ?? ""}
                  data-size-min={size.quantidade_minima}
                  data-size-image={size.imagem ?? ""}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {size.nome}
                </button>
              ))}
            </div>

          </div>
        )}



        {hasFlavors && (
          <div class="product-detail__flavors">

            <span class="product-detail__flavors-label">
              Escolha o sabor
            </span>

            <div
              class="product-detail__flavor-options"
              role="radiogroup"
              aria-label="Sabor"
              data-flavor-group
            >
              {product.flavors.map((flavor, index) => (
                <button
                  type="button"
                  class:list={[
                    "product-detail__flavor-option",
                    { "is-selected": index === 0 }
                  ]}
                  data-flavor-option
                  data-flavor-name={flavor.nome}
                  data-flavor-image={flavor.imagem}
                  data-flavor-price={flavor.preco ?? ""}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {flavor.nome}
                </button>
              ))}
            </div>

          </div>
        )}



        {hasVariantGroups && (
          <div class="product-detail__variant-groups" data-variant-groups>
            {product.variantGroups.map((grupo) => (
              <div class="product-detail__flavors">
                <span class="product-detail__flavors-label">
                  {grupo.nome}
                </span>

                <div
                  class="product-detail__flavor-options"
                  role="radiogroup"
                  aria-label={grupo.nome}
                  data-variant-group
                  data-group-name={grupo.nome}
                >
                  {grupo.opcoes.map((opcao) => (
                    <button
                      type="button"
                      class="product-detail__flavor-option"
                      data-variant-option
                      data-option-value={opcao}
                      aria-pressed="false"
                    >
                      {opcao}
                    </button>
                  ))}
                </div>
              </div>
            ))}

            <p class="product-detail__helper" data-variant-groups-hint>
              Escolha uma opção em cada grupo para poder adicionar à encomenda.
            </p>
          </div>
        )}



        {hasTiers && (
          <div class="product-detail__tiers" data-price-tiers={tiersJson}>
            <span class="product-detail__flavors-label">
              Preço por quantidade
            </span>

            <ul>
              {tierRows.map((row, index) => (
                <li
                  data-tier-row
                  data-tier-min={row.min}
                  class:list={{ "is-active": index === 0 }}
                >
                  <span>{row.label} un.</span>
                  <strong>
                    {row.price !== null ? `${euro.format(row.price)} / un.` : product.priceLabel}
                  </strong>
                </li>
              ))}
            </ul>
          </div>
        )}



        <div class="product-detail__quantity" data-quantity-picker>
          <span class="product-detail__flavors-label">
            Quantidade
          </span>

          <div class="product-detail__quantity-control">
            <button
              type="button"
              data-quantity-decrease
              aria-label="Diminuir quantidade"
              disabled
            >
              −
            </button>

            <input
              type="number"
              inputmode="numeric"
              min={initialMinQuantity}
              max={QUANTIDADE_MAXIMA}
              step="1"
              value={initialMinQuantity}
              aria-label="Quantidade"
              data-quantity-input
            />

            <button
              type="button"
              data-quantity-increase
              aria-label="Aumentar quantidade"
            >
              +
            </button>
          </div>

          <small
            class="product-detail__minimum"
            data-minimum-note
            hidden={initialMinQuantity <= 1}
          >
            Encomenda mínima: <span data-minimum-value>{initialMinQuantity}</span> unidades
          </small>

          {hasTiers && (
            <p class="product-detail__tier-note" data-tier-note aria-live="polite"></p>
          )}
        </div>



        <div class="product-detail__notice">

          <span aria-hidden="true">
            ✦
          </span>

          <p>
            A decoração, os sabores, as cores e os detalhes
            podem ser personalizados de acordo com a celebração.
          </p>

        </div>



        <div class="product-detail__actions">


          <button
            type="button"
            class="button button--primary"
            data-add-to-cart
            data-product-id={product.id}
            data-product-name={product.name}
            data-product-image={displayImage}
            data-product-price={initialPrice ?? ""}
            data-product-size={defaultSize?.nome ?? ""}
            data-product-price-label={product.priceLabel}
            data-category-slug={product.categorySlug}
            data-product-slug={product.slug}
            data-product-flavor={defaultFlavor ? `Sabor: ${defaultFlavor.nome}` : ""}
            data-product-min-quantity={initialMinQuantity}
            data-product-price-tiers={tiersJson}
            data-product-quantity={initialMinQuantity}
            disabled={hasVariantGroups}
          >
            Adicionar à encomenda
          </button>



          <a
            href={`/catalogo/${product.categorySlug}`}
            class="button button--secondary"
          >
            Voltar à categoria
          </a>


        </div>



        <p class="product-detail__helper">
          O pedido será enviado para orçamento. Não existe pagamento
          online nesta etapa.
        </p>


      </div>


    </div>


  </section>


  <script>
    import "@/scripts/product-flavors.ts";
    import "@/scripts/product-variant-groups.ts";
    import "@/scripts/product-gallery.ts";
    import "@/scripts/product-quantity.ts";
    import "@/scripts/product-sizes.ts";
  </script>


</MainLayout>
