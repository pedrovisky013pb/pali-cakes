---
import MainLayout from "@/layouts/MainLayout.astro";

// Redes sociais reais, confirmadas pela Bruna. Sem telefone/WhatsApp
// publicado — o contacto direto é feito pelo formulário abaixo.
const INSTAGRAM_HANDLE = "@palicakes";
const INSTAGRAM_URL = "https://www.instagram.com/palicakes/";
const FACEBOOK_HANDLE = "@Palicakes";
const FACEBOOK_URL = "https://www.facebook.com/Palicakes/";
const TIKTOK_HANDLE = "@brunapaliotes";
const TIKTOK_URL = "https://www.tiktok.com/@brunapaliotes";
---

<MainLayout
  title="Contactos | Pali Cakes"
  description="Envie uma mensagem à Pali Cakes ou acompanhe-nos nas redes sociais."
>
  <section class="faq-hero">
    <div class="container">
      <span class="section-title__eyebrow">Fale connosco</span>

      <h1>Contactos</h1>

      <p>
        Tem uma ideia para a sua celebração ou alguma dúvida antes de
        encomendar? Estamos aqui para ajudar.
      </p>
    </div>
  </section>

  <section class="faq-page">
    <div class="container">
      <div class="faq-group contact-cards">
        <div class="faq-notice">
          <h2>Instagram</h2>
          <p>
            Acompanhe os trabalhos da Pali Cakes em
            {" "}<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              <strong>{INSTAGRAM_HANDLE}</strong>
            </a>.
          </p>
        </div>
        <div class="faq-notice">
          <h2>Facebook</h2>
          <p>
            Siga a Pali Cakes no Facebook em
            {" "}<a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">
              <strong>{FACEBOOK_HANDLE}</strong>
            </a>.
          </p>
        </div>
        <div class="faq-notice">
          <h2>TikTok</h2>
          <p>
            Veja os vídeos da Pali Cakes no TikTok em
            {" "}<a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer">
              <strong>{TIKTOK_HANDLE}</strong>
            </a>.
          </p>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <div class="contact-form-wrapper__intro">
          <h2>Envie a sua mensagem</h2>
          <p>
            Preencha o formulário com a sua dúvida ou ideia de celebração —
            a Pali Cakes responde diretamente para o seu email.
          </p>
        </div>

        <form class="contact-form" data-contact-form>
          <div class="checkout-form__grid">
            <label class="form-field">
              <span>Nome completo *</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>

            <label class="form-field">
              <span>Email *</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>

            <label class="form-field form-field--full">
              <span>Telefone</span>
              <input type="tel" name="phone" autocomplete="tel" />
            </label>

            <label class="form-field form-field--full">
              <span>Mensagem *</span>
              <textarea name="message" rows="5" required></textarea>
            </label>
          </div>

          <button
            type="submit"
            class="button button--primary checkout-form__submit"
            data-contact-submit
          >
            Enviar mensagem
          </button>

          <p
            class="checkout-form__helper"
            data-contact-helper
            role="status"
            aria-live="polite"
          ></p>
        </form>
      </div>

      <div class="faq-cta">
        <span class="section-title__eyebrow">Já sabe o que quer?</span>
        <h2>Comece a sua encomenda</h2>
        <p>Explore o catálogo e envie-nos os detalhes da sua celebração.</p>
        <a href="/catalogo/bolos-personalizados" class="button button--primary">Ver catálogo</a>
      </div>
    </div>
  </section>

  <script>
    import "../scripts/contact-form.ts";
  </script>
</MainLayout>
